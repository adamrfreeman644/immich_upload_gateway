# Admin authentication. Keep AUTH_ENABLED=false during migration until the
# Authentik provider/client and redirect URI have been configured and tested.
AUTH_ENABLED=false
OIDC_ISSUER=https://auth.example.com/application/o/image-upload-gateway
OIDC_CLIENT_ID=image-upload-gateway
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=https://uploads.example.com/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://uploads.example.com/admin

# Legacy admin password is used only while AUTH_ENABLED=false for migration or rollback.
ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
COOKIE_SECURE=true
MAX_FILE_MB=5000

# Set GATEWAY_PORT=8093 for a side-by-side test while the old 0.2.0 container remains on 8092.
GATEWAY_PORT=8092
# Give each parallel install its own Compose project name.
COMPOSE_PROJECT_NAME=immich-upload-gateway
# Absolute path to this checked-out repository. Required by the updater sidecar.
APP_HOST_PATH=/mnt/user/appdata/immich-upload-gateway

# Persistent data. Point CONFIG_HOST_PATH at the existing 0.2.0 config directory to migrate in place.
CONFIG_HOST_PATH=/mnt/user/appdata/immich-upload-gateway/config
WORK_FALLBACK_HOST_PATH=/mnt/user/PhotoUploadFallback/Work
PERSONAL_FALLBACK_HOST_PATH=/mnt/user/PhotoUploadFallback/Personal
PORTAL_FALLBACK_HOST_PATH=/mnt/user/PhotoUploadFallback/Portals

REPO=adamrfreeman644/immich_upload_gateway
BRANCH=main
